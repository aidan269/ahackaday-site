# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# Next.js loads `.env.local` automatically for `npm run dev`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data: `markdown` (content/*.md) or `supabase` (live DB) ---
DATA_SOURCE=markdown

# --- Supabase (required when DATA_SOURCE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server-only: ingest + admin writes (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (ingest summarization) ---
ANTHROPIC_API_KEY=
# Optional override; default in code is a stable Sonnet id
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ingest cron / manual trigger ---
# Must match: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/ingest
CRON_SECRET=
