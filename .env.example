# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# Next.js loads `.env.local` automatically for `npm run dev`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Grace app origin (no trailing slash); enables “Open in Grace” + Grace row in Toolkit
# NEXT_PUBLIC_GRACE_ORIGIN=https://your-grace-app.vercel.app

# --- Data: `markdown` (content/*.md) or `supabase` (live DB) ---
DATA_SOURCE=markdown

# --- Supabase (required when DATA_SOURCE=supabase) ---
# 1) Create project at supabase.com → copy Project URL + keys
# 2) Run SQL in supabase/migrations/20260427000000_incidents.sql (SQL Editor)
# 3) Set DATA_SOURCE=supabase on Vercel + verify GET /api/health/supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server-only: ingest + admin writes (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (ingest summarization) ---
ANTHROPIC_API_KEY=
# Optional override; default in code is a stable Sonnet id
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ingest cron / manual trigger ---
# Must match: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/ingest
CRON_SECRET=
