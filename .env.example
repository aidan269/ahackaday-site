# Copy to `.env.local` and fill in values. Never commit `.env.local`.
# Next.js loads `.env.local` automatically for `npm run dev`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Grace app origin (no trailing slash, no path/hash); enables “Open in Grace” + Toolkit link.
# Use the URL where Grace is actually deployed — it does NOT have to be on the same Vercel team
# as AHackaday (e.g. Spearbit can point at Grace on Hobby or a custom domain).
# NEXT_PUBLIC_GRACE_ORIGIN=https://grace.example.com

# --- Data: `markdown` (content/*.md) or `supabase` (live DB) ---
DATA_SOURCE=markdown

# --- Supabase (required when DATA_SOURCE=supabase) ---
# 1) Create project at supabase.com → copy Project URL + keys
# 2) Run SQL in supabase/migrations/20260427000000_incidents.sql (SQL Editor)
# 3) Set DATA_SOURCE=supabase on Vercel + verify GET /api/health/supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Server-only: ingest + admin writes (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (ingest summarization) ---
ANTHROPIC_API_KEY=
# Optional override; default in code is a stable Sonnet id
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ingest cron / manual trigger ---
# Must match: curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/ingest
CRON_SECRET=
#
# --- Ingest: budget (Anthropic) ---
# - Each *new* article = one Claude call (similar cost per call; ~article_size affects tokens).
# - Rows already in Supabase (same source_url) are SKIPPED: DB read only, no Claude.
# - INGEST_MAX_NEW_PER_RUN: stop after this many *new* articles in one run (default 40 in code). Use e.g. 15–25 to stay conservative.
# - Per-feed `itemLimit` in INGEST_FEEDS: max items read from that feed; lower = less surface area for noisy sources.
# - More frequent Vercel crons = more *runs*, but every run still obeys INGEST_MAX_NEW_PER_RUN.
# INGEST_MAX_NEW_PER_RUN=20
# When using INGEST_FEEDS JSON, per-feed itemLimit defaults to this if omitted
# INGEST_DEFAULT_ITEM_LIMIT=10
# Optional: full feed list. If unset, the default list in src/lib/ingest-config.ts is used (CISA, Krebs, Bleeping, THN Feedburner, SecurityWeek).
# INGEST_FEEDS=[{"url":"https://example.com/feed.xml","source":"Example","itemLimit":10,"enabled":true}]
